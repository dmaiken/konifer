{
  "methodology": "single-vu-v1",
  "baseUrl": "http://localhost:8080",
  "profiles": {
    "read": {
      "warmup": {"samples": 100, "minDuration": "10s", "maxDuration": "1m"},
      "measurement": {"samples": 1000, "minDuration": "30s", "maxDuration": "2m"}
    },
    "light": {
      "warmup": {"samples": 30, "minDuration": "10s", "maxDuration": "2m"},
      "measurement": {"samples": 200, "minDuration": "30s", "maxDuration": "5m"}
    },
    "heavy": {
      "warmup": {"samples": 20, "minDuration": "10s", "maxDuration": "2m"},
      "measurement": {"samples": 200, "minDuration": "30s", "maxDuration": "5m"}
    },
    "inference": {
      "warmup": {"samples": 20, "minDuration": "10s", "maxDuration": "2m"},
      "measurement": {"samples": 200, "minDuration": "30s", "maxDuration": "5m"}
    }
  },
  "suites": {
    "smoke": {
      "repetitions": 1,
      "workloads": [
        "upload.original",
        "variant.generate.cold",
        "variant.deliver.cached",
        "upload.preprocess",
        "upload.rules",
        "upload.rules.preprocess"
      ]
    },
    "release": {
      "repetitions": 3,
      "workloads": [
        "upload.original",
        "delivery.original.cached",
        "variant.generate.cold",
        "variant.deliver.cached",
        "upload.preprocess",
        "upload.rules",
        "upload.rules.preprocess",
        "upload.eager.accept",
        "variant.eager.ready",
        "format.decode",
        "format.encode"
      ]
    }
  },
  "workloads": {
    "upload.original": {
      "description": "Upload an original image without transformation or inference, including metadata and object storage writes.",
      "profile": "light",
      "fixture": "photo-medium",
      "sourceFormat": "jpg",
      "case": "jpg-medium"
    },
    "delivery.original.cached": {
      "description": "Download an existing original without image processing.",
      "profile": "read",
      "fixture": "photo-medium",
      "sourceFormat": "jpg",
      "case": "jpg-medium"
    },
    "variant.generate.cold": {
      "description": "Fetch the original, decode, transform, encode, store, and return a new variant.",
      "profile": "heavy",
      "fixture": "photo-medium",
      "sourceFormat": "jpg",
      "case": "jpg-to-webp-400",
      "query": {"width": 400, "fit": "fit", "format": "webp", "quality": 80, "rotate": "auto"}
    },
    "variant.deliver.cached": {
      "description": "Download a variant from setup, without repeating the transformation.",
      "profile": "read",
      "fixture": "photo-medium",
      "sourceFormat": "jpg",
      "case": "jpg-to-webp-400",
      "query": {"width": 400, "fit": "fit", "format": "webp", "quality": 80, "rotate": "auto"}
    },
    "upload.preprocess": {
      "description": "Upload an image and convert it to WebP with padding.",
      "profile": "heavy",
      "fixture": "photo-medium",
      "sourceFormat": "jpg",
      "case": "jpg-medium-to-webp",
      "path": "/test-upload-preprocessing",
      "expected": {"format": "webp", "width": 994, "height": 1314}
    },
    "upload.rules": {
      "description": "Run Upload Rules inference during upload and check the resulting metadata label.",
      "profile": "inference",
      "fixture": "photo-medium",
      "sourceFormat": "jpg",
      "case": "jpg-medium-landscape-rule",
      "path": "/test-upload-rules"
    },
    "upload.rules.preprocess": {
      "description": "Run Upload Rules inference during upload and convert the original to padded WebP.",
      "profile": "inference",
      "fixture": "photo-medium",
      "sourceFormat": "jpg",
      "case": "jpg-medium-landscape-rule-to-webp",
      "path": "/test-upload-rules-preprocessing",
      "expected": {"format": "webp", "width": 994, "height": 1314}
    },
    "upload.eager.accept": {
      "description": "Upload an image and schedule four WebP variants. Measure upload acceptance without waiting for the variants to finish.",
      "profile": "light",
      "fixture": "photo-medium",
      "sourceFormat": "jpg",
      "case": "jpg-medium-four-webp-profiles",
      "path": "/test-upload-eager-variants",
      "profiles": ["thumbnail-200", "thumbnail-400", "thumbnail-600", "sepia-original"],
      "timeoutSeconds": 30
    },
    "variant.eager.ready": {
      "description": "Measure the wait from upload acceptance until four WebP variants are ready. Check that each download hits the cache.",
      "profile": "heavy",
      "fixture": "photo-medium",
      "sourceFormat": "jpg",
      "case": "jpg-medium-four-webp-profiles",
      "path": "/test-upload-eager-variants",
      "profiles": ["thumbnail-200", "thumbnail-400", "thumbnail-600", "sepia-original"],
      "expectedFormat": "webp",
      "timeoutSeconds": 30
    },
    "format.decode": {
      "description": "Generate a resized WebP variant from each source format, using the same transformation.",
      "profile": "heavy",
      "fixture": "photo-medium",
      "query": {"width": 400, "fit": "fit", "format": "webp", "quality": 80},
      "cases": [
        {"id": "avif-to-webp", "sourceFormat": "avif"},
        {"id": "gif-to-webp", "sourceFormat": "gif"},
        {"id": "heic-to-webp", "sourceFormat": "heic"},
        {"id": "jpg-to-webp", "sourceFormat": "jpg"},
        {"id": "jxl-to-webp", "sourceFormat": "jxl"},
        {"id": "png-to-webp", "sourceFormat": "png"},
        {"id": "webp-to-webp", "sourceFormat": "webp"}
      ]
    },
    "format.encode": {
      "description": "Resize a JPEG and encode the variant in each destination format.",
      "profile": "heavy",
      "fixture": "photo-medium",
      "sourceFormat": "jpg",
      "query": {"width": 400, "fit": "fit", "quality": 80},
      "cases": [
        {"id": "jpg-to-avif", "destinationFormat": "avif"},
        {"id": "jpg-to-gif", "destinationFormat": "gif"},
        {"id": "jpg-to-heic", "destinationFormat": "heic"},
        {"id": "jpg-to-jpg", "destinationFormat": "jpg"},
        {"id": "jpg-to-jxl", "destinationFormat": "jxl"},
        {"id": "jpg-to-png", "destinationFormat": "png"},
        {"id": "jpg-to-webp", "destinationFormat": "webp"}
      ]
    }
  }
}
