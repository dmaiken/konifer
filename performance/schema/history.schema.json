{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konifer.io/schemas/performance-history.schema.json",
  "title": "Konifer published performance history",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "releases"],
  "properties": {
    "version": {"const": 1},
    "releases": {
      "type": "array",
      "items": {"$ref": "#/$defs/release"}
    }
  },
  "$defs": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "runId", "suite", "environment", "subject", "startedAt", "completedAt", "results", "passed"],
      "properties": {
        "version": {"const": 1},
        "runId": {"type": "string", "minLength": 1},
        "suite": {"const": "release"},
        "environment": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "startedAt": {"type": "string", "format": "date-time"},
        "completedAt": {"type": "string", "format": "date-time"},
        "notes": {"$ref": "#/$defs/notes"},
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/result"}
        },
        "passed": {"type": "boolean"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload", "case", "repetitions", "operations", "requests", "errors", "checks", "droppedIterations", "durationMs", "passed"],
      "properties": {
        "workload": {"type": "string", "minLength": 1},
        "case": {"type": "string", "minLength": 1},
        "repetitions": {"type": "integer", "minimum": 1},
        "operations": {"type": "integer", "minimum": 1},
        "requests": {"type": "integer", "minimum": 1},
        "errors": {"type": "integer", "minimum": 0},
        "checks": {"$ref": "#/$defs/checks"},
        "droppedIterations": {"type": "integer", "minimum": 0},
        "durationMs": {"$ref": "#/$defs/duration"},
        "notes": {"$ref": "#/$defs/notes"},
        "passed": {"type": "boolean"}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed"],
      "properties": {
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p50", "p90", "p95", "p99", "p95Min", "p95Max"],
      "properties": {
        "p50": {"type": "number", "minimum": 0},
        "p90": {"type": "number", "minimum": 0},
        "p95": {"type": "number", "minimum": 0},
        "p99": {"type": "number", "minimum": 0},
        "p95Min": {"type": "number", "minimum": 0},
        "p95Max": {"type": "number", "minimum": 0}
      }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    }
  }
}
