{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konifer.io/schemas/performance-workloads.schema.json",
  "title": "Konifer performance workload catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["baseUrl", "profiles", "suites", "workloads"],
  "properties": {
    "baseUrl": {"type": "string", "format": "uri"},
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/profile"}
    },
    "suites": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/suite"}
    },
    "workloads": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/workload"}
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration", "rate", "timeUnit"],
      "properties": {
        "duration": {"type": "string", "pattern": "^[1-9][0-9]*(?:ms|s|m|h)$"},
        "rate": {"type": "number", "exclusiveMinimum": 0},
        "timeUnit": {"type": "string", "pattern": "^[1-9][0-9]*(?:ms|s|m|h)$"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmup", "measurement", "preAllocatedVUs", "maxVUs"],
      "properties": {
        "warmup": {"$ref": "#/$defs/phase"},
        "measurement": {"$ref": "#/$defs/phase"},
        "preAllocatedVUs": {"type": "integer", "minimum": 1},
        "maxVUs": {"type": "integer", "minimum": 1}
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repetitions", "workloads"],
      "properties": {
        "repetitions": {"type": "integer", "minimum": 1},
        "workloads": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sourceFormat": {"type": "string", "minLength": 1},
        "destinationFormat": {"type": "string", "minLength": 1}
      }
    },
    "queryValue": {
      "anyOf": [
        {"type": "string"},
        {"type": "number"},
        {"type": "boolean"}
      ]
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "profile", "fixture"],
      "properties": {
        "description": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "profile": {"type": "string", "minLength": 1},
        "fixture": {"type": "string", "minLength": 1},
        "sourceFormat": {"type": "string", "minLength": 1},
        "case": {"type": "string", "minLength": 1},
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/case"}
        },
        "query": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/queryValue"}
        },
        "path": {"type": "string", "pattern": "^/"},
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "width", "height"],
          "properties": {
            "format": {"type": "string", "minLength": 1},
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1}
          }
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "timeoutSeconds": {"type": "integer", "minimum": 1}
      },
      "oneOf": [
        {"properties": {"case": true}, "required": ["case"]},
        {"properties": {"cases": true}, "required": ["cases"]}
      ]
    }
  }
}
