{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "defaultProfile", "profiles"],
  "properties": {
    "version": {"const": 1},
    "defaultProfile": {"type": "string", "minLength": 1},
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/profile"}
    }
  },
  "$defs": {
    "duration": {"type": "string", "pattern": "^[1-9][0-9]*(?:ms|s|m|h)$"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "timeUnit", "rampUpDuration", "steadyDuration", "rampDownDuration", "recoveryTimeout", "streams", "recovery"],
      "properties": {
        "description": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "timeUnit": {"$ref": "#/$defs/duration"},
        "rampUpDuration": {"$ref": "#/$defs/duration"},
        "steadyDuration": {"$ref": "#/$defs/duration"},
        "rampDownDuration": {"$ref": "#/$defs/duration"},
        "recoveryTimeout": {"$ref": "#/$defs/duration"},
        "streams": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/stream"}
        },
        "recovery": {"$ref": "#/$defs/workloadReference"}
      }
    },
    "workloadReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload", "case"],
      "properties": {
        "workload": {"type": "string", "minLength": 1},
        "case": {"type": "string", "minLength": 1}
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workload", "case", "exec", "startRate", "targetRate", "preAllocatedVUs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "workload": {"type": "string", "minLength": 1},
        "case": {"type": "string", "minLength": 1},
        "exec": {"type": "string", "minLength": 1},
        "startRate": {"type": "integer", "minimum": 1},
        "targetRate": {"type": "integer", "minimum": 1},
        "preAllocatedVUs": {"type": "integer", "minimum": 1}
      }
    }
  }
}
