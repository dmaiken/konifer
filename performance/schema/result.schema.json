{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runId", "suite", "workload", "case", "repetition", "environment", "subject", "startedAt", "completedAt", "metrics", "passed"],
  "$defs": {
    "benchmarkPhase": {
      "type": "object", "additionalProperties": false,
      "required": ["samples", "minDuration", "maxDuration"],
      "properties": {
        "samples": {"type": "integer", "minimum": 1},
        "minDuration": {"type": "string", "pattern": "^[1-9][0-9]*(?:ms|s|m|h)$"},
        "maxDuration": {"type": "string", "pattern": "^[1-9][0-9]*(?:ms|s|m|h)$"}
      }
    },
    "benchmark": {
      "type": "object", "additionalProperties": false,
      "required": ["methodology", "warmup", "measurement"],
      "properties": {
        "methodology": {"const": "single-vu-v1"},
        "warmup": {"$ref": "#/$defs/benchmarkPhase"},
        "measurement": {"$ref": "#/$defs/benchmarkPhase"}
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"passed": {"const": true}}, "required": ["passed"]},
    "then": {"properties": {"metrics": {"type": "object", "properties": {
      "operations": {"type": "integer", "minimum": 1}, "requests": {"type": "integer", "minimum": 1}
    }}}}
  }],
  "properties": {
    "benchmark": {"$ref": "#/$defs/benchmark"},
    "version": {"const": 1},
    "runId": {"type": "string", "minLength": 1},
    "suite": {"enum": ["smoke", "release"]},
    "workload": {"type": "string", "minLength": 1},
    "case": {"type": "string", "minLength": 1},
    "repetition": {"type": "integer", "minimum": 1},
    "environment": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations", "requests", "errors", "checks", "droppedIterations", "durationMs"],
      "properties": {
        "operations": {"type": "integer", "minimum": 0},
        "requests": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passed", "failed"],
          "properties": {
            "passed": {"type": "integer", "minimum": 0},
            "failed": {"type": "integer", "minimum": 0}
          }
        },
        "droppedIterations": {"type": "integer", "minimum": 0},
        "durationMs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "p50", "p90", "p95", "p99", "max"],
          "properties": {
            "min": {"type": "number", "minimum": 0},
            "p50": {"type": "number", "minimum": 0},
            "p90": {"type": "number", "minimum": 0},
            "p95": {"type": "number", "minimum": 0},
            "p99": {"type": "number", "minimum": 0},
            "max": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    "passed": {"type": "boolean"}
  }
}
