{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konifer.io/schemas/performance-load-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runId", "profile", "environment", "subject", "startedAt", "completedAt", "trafficDurationSeconds", "peakRatePerMinute", "targetOperations", "operations", "requests", "errors", "checks", "droppedIterations", "streams", "recovery", "passed"],
  "properties": {
    "version": {"const": 1},
    "runId": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"},
    "trafficDurationSeconds": {"type": "number", "exclusiveMinimum": 0},
    "peakRatePerMinute": {"type": "number", "exclusiveMinimum": 0},
    "targetOperations": {"type": "integer", "minimum": 1},
    "operations": {"type": "integer", "minimum": 0},
    "requests": {"type": "integer", "minimum": 0},
    "errors": {"type": "integer", "minimum": 0},
    "checks": {"$ref": "#/$defs/checks"},
    "droppedIterations": {"type": "integer", "minimum": 0},
    "notes": {"$ref": "#/$defs/notes"},
    "streams": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/stream"}
    },
    "recovery": {"$ref": "#/$defs/recovery"},
    "passed": {"type": "boolean"}
  },
  "$defs": {
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed"],
      "properties": {
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p50", "p90", "p95", "p99"],
      "properties": {
        "p50": {"type": "number", "minimum": 0},
        "p90": {"type": "number", "minimum": 0},
        "p95": {"type": "number", "minimum": 0},
        "p99": {"type": "number", "minimum": 0}
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workload", "case", "targetRatePerMinute", "plannedOperations", "operations", "requests", "errors", "checks", "droppedIterations", "durationMs", "passed"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "workload": {"type": "string", "minLength": 1},
        "case": {"type": "string", "minLength": 1},
        "targetRatePerMinute": {"type": "number", "exclusiveMinimum": 0},
        "plannedOperations": {"type": "integer", "minimum": 1},
        "operations": {"type": "integer", "minimum": 0},
        "requests": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "checks": {"$ref": "#/$defs/checks"},
        "droppedIterations": {"type": "integer", "minimum": 0},
        "durationMs": {"$ref": "#/$defs/duration"},
        "notes": {"$ref": "#/$defs/notes"},
        "passed": {"type": "boolean"}
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["healthPassed", "eagerReady", "durationMs", "checks", "passed"],
      "properties": {
        "healthPassed": {"type": "boolean"},
        "eagerReady": {"type": "boolean"},
        "durationMs": {"type": "number", "minimum": 0},
        "checks": {"$ref": "#/$defs/checks"},
        "passed": {"type": "boolean"}
      }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    }
  }
}
