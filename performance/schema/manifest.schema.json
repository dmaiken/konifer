{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konifer.io/schemas/performance-fixture-manifest.schema.json",
  "title": "Konifer performance fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixtures"],
  "properties": {
    "fixtures": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/fixture"}
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mediaType", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "mediaType": {"type": "string", "pattern": "^image/[A-Za-z0-9.+-]+$"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "files"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "files": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/file"}
        }
      }
    }
  }
}
